# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Database. docker-compose.yml builds this URL from POSTGRES_PASSWORD; set it yourself only when
# running the API outside Compose, e.g. postgresql+psycopg://autoapplier:<pw>@localhost:5432/autoapplier
POSTGRES_PASSWORD=change-me
# AUTOAPPLIER_DATABASE_URL=

# Encrypts stored CVs and profile data. Generate with:
#   docker compose run --rm api python -m backend.admin gen-key
# Losing this key makes stored profiles unreadable; changing it requires re-saving them.
AUTOAPPLIER_DATA_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-5.4-mini
# AUTOAPPLIER_RATE_LIMIT=10
# AUTOAPPLIER_JOB_TTL=900
# AUTOAPPLIER_WORKERS=2
# AUTOAPPLIER_COMPILE_TIMEOUT=30
